# Copy to .env and adjust. All settings use the APP_ prefix.
APP_ENVIRONMENT=dev
APP_BASE_URL=http://localhost:8000
APP_LOG_LEVEL=INFO
# json in production, console for readable local output
APP_LOG_FORMAT=console

APP_DATABASE_URL=postgresql+asyncpg://shortener:shortener@localhost:5432/shortener
APP_DB_POOL_SIZE=5
APP_DB_MAX_OVERFLOW=10

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=change-me
APP_ACCESS_TOKEN_TTL_SECONDS=900
APP_REFRESH_TOKEN_TTL_SECONDS=1209600

APP_REDIS_URL=redis://localhost:6379/0
APP_CACHE_TTL_SECONDS=3600
APP_CACHE_NEGATIVE_TTL_SECONDS=30
APP_L1_CACHE_TTL_SECONDS=5
APP_L1_CACHE_MAX_ENTRIES=10000

APP_RATE_LIMIT_ENABLED=true
# Nested fields use a double underscore:
APP_RATE_LIMIT_AUTH__CAPACITY=10
APP_RATE_LIMIT_AUTH__REFILL_PER_SECOND=0.1667

# Keyed hash for visitor IPs in click analytics
APP_ANALYTICS_SALT=change-me
APP_CLICK_BATCH_SIZE=500
